node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.env
.env.local
# The repository root ignores .env.* which also catches .env.example -- the one
# env file that must be committed, since it documents every option. A negation
# in a nested .gitignore takes precedence over the parent pattern.
!.env.example
prisma/dev.db
prisma/dev.db-journal
public/renders/*
!public/renders/.gitkeep
storage/

# One-off driver scripts used to exercise the pipeline by hand. These are
# throwaways that keep appearing at the app root and are not part of the app.
/*.local.ts
scratch/
