# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"        # or postgresql://user:pass@host:5432/db
AUTH_SECRET="change-me-to-32+-random-bytes"
STORAGE_DIR="./storage"
PUBLIC_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional AI providers.
# Every one of these is OFF by default. With none set, the platform runs on
# built-in stub providers and is fully functional end to end -- scripts, scene
# breakdown, caption timing, placeholder visuals and a real rendered MP4.
# Setting a key swaps in the hosted provider for that stage only; no code
# change is needed anywhere else.
# ---------------------------------------------------------------------------

# Script writing (pick one). Gemini has a genuinely free tier and no card
# requirement: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini|anthropic|openai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Voiceover. Speech is synthesised LOCALLY by default -- no key needed.
# Install with: pip install piper-tts && npm run fetch-voices
# Falls back to espeak-ng, then to a silent track. Set a key to override.
# TTS_PROVIDER=elevenlabs|openai|local
# ELEVENLABS_API_KEY=
# PIPER_VOICE_DIR=./storage/voices

# Scene stills (pick one)
# IMAGE_PROVIDER=openai|replicate
# REPLICATE_API_TOKEN=

# Scene motion clips (pick one). Without these the built-in procedural
# clip generator is used -- real animated MP4s, abstract rather than
# photographic.
# VIDEO_PROVIDER=replicate|luma
# REPLICATE_API_TOKEN=
# REPLICATE_VIDEO_VERSION=
# LUMA_API_KEY=
# VIDEO_TIMEOUT_MS=300000

# Publishing (each optional)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Rendering
# FFMPEG_PATH=/usr/bin/ffmpeg     # auto-detected when omitted

# Local 3D renderer. 'fast' is the in-process rasterizer (seconds per clip);
# 'blender' is path traced with real shadows and depth of field (minutes per
# clip). Free either way -- no API key. Per-video choice overrides this.
# VIDEO_RENDERER=fast|blender
# BLENDER_PATH=/usr/bin/blender   # auto-detected when omitted
# BLENDER_SAMPLES=40
# BLENDER_SCALE=0.62
# BLENDER_FPS=8
# BLENDER_CLIP_SECONDS=3
# BLENDER_TIMEOUT_MS=1200000
